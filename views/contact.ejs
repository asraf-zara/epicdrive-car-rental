<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <section class="page-hero contact-page-hero">
    <div class="container page-hero-inner reveal">
      <span class="eyebrow">Talk to EPICDRIVE</span>
      <h1>Ready when<br /><span>you are.</span></h1>
      <p>Contact us directly for availability, pricing and booking confirmation.</p>
    </div>
  </section>

  <section class="contact-section section-padding">
    <div class="container contact-grid">
      <article class="contact-card reveal">
        <span class="contact-icon">01</span>
        <span class="eyebrow">Phone</span>
        <h2><%= site.phone %></h2>
        <p>Call us for quick rental assistance and availability.</p>
        <a class="button button-dark" href="tel:<%= site.phoneLink %>">Call Now</a>
      </article>

      <article class="contact-card contact-card-dark reveal">
        <span class="contact-icon">02</span>
        <span class="eyebrow">WhatsApp</span>
        <h2>Message EPICDRIVE</h2>
        <p>Send the car name and preferred rental date. We will help you continue from there.</p>
        <a class="button button-primary" target="_blank" rel="noopener" href="https://wa.me/<%= site.whatsapp %>?text=Hello%20EPICDRIVE%2C%20I%20would%20like%20to%20ask%20about%20a%20car%20rental.">Open WhatsApp</a>
      </article>

      <article class="contact-card reveal">
        <span class="contact-icon">03</span>
        <span class="eyebrow">Location</span>
        <h2><%= site.location %></h2>
        <p>Pickup and rental arrangements are confirmed directly with our team.</p>
        <button class="button button-dark js-open-booking" data-car="General Booking" data-price="Choose your vehicle">Book a Car</button>
      </article>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
