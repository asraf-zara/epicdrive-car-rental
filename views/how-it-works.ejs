<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <section class="page-hero process-page-hero">
    <div class="container page-hero-inner reveal">
      <span class="eyebrow">Simple from start to finish</span>
      <h1>Choose. Contact.<br /><span>Drive.</span></h1>
      <p>EPICDRIVE keeps the rental process direct and easy.</p>
    </div>
  </section>

  <section class="timeline-section section-padding">
    <div class="container timeline">
      <article class="timeline-item reveal"><div class="timeline-number">01</div><div><span class="eyebrow">Choose your car</span><h2>Find the right drive.</h2><p>Explore our three vehicles and compare their space, comfort and rental rate.</p><a class="text-link" href="/cars">Explore all cars →</a></div></article>
      <article class="timeline-item reveal"><div class="timeline-number">02</div><div><span class="eyebrow">Contact EPICDRIVE</span><h2>Book directly.</h2><p>Press Book Now on any vehicle. Your contact options appear instantly, including phone and WhatsApp.</p><button class="text-link button-link js-open-booking" data-car="General Booking" data-price="Choose your vehicle">Open booking contact →</button></div></article>
      <article class="timeline-item reveal"><div class="timeline-number">03</div><div><span class="eyebrow">Confirm & drive</span><h2>Finalize the details.</h2><p>Confirm availability, rental period and pickup details with our team, then enjoy your journey.</p></div></article>
    </div>
  </section>

  <section class="final-cta section-padding">
    <div class="container final-cta-inner reveal">
      <div><span class="eyebrow">Start now</span><h2>Your next car is a few clicks away.</h2></div>
      <a class="button button-light" href="/cars">Choose a Car</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
