<footer class="site-footer">
  <div class="footer-top container">
    <div class="footer-brand-block">
      <img src="/images/epicdrive-logo.png" alt="EPICDRIVE" class="footer-logo" />
      <p>Modern car rental, direct booking and a smoother way to start your journey.</p>
    </div>

    <div class="footer-links">
      <div>
        <h4>Explore</h4>
        <a href="/">Home</a>
        <a href="/cars">Cars</a>
        <a href="/how-it-works">How It Works</a>
      </div>
      <div>
        <h4>Contact</h4>
        <a href="tel:<%= site.phoneLink %>"><%= site.phone %></a>
        <span><%= site.location %></span>
