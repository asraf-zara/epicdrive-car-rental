<header class="site-header" id="siteHeader">
  <div class="nav-shell">
    <a href="/" class="brand" aria-label="EPICDRIVE Home">
      <img src="/images/epicdrive-logo.png" alt="EPICDRIVE Car Rentals" class="brand-logo" />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
      <a class="<%= currentPath.startsWith('/cars') ? 'active' : '' %>" href="/cars">Cars</a>
      <a class="<%= currentPath === '/how-it-works' ? 'active' : '' %>" href="/how-it-works">How It Works</a>
      <a class="<%= currentPath === '/contact' ? 'active' : '' %>" href="/contact">Contact</a>
