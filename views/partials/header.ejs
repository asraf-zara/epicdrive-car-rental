    <button class="nav-book-btn js-open-booking" data-car="General Booking" data-price="Choose your vehicle">
      Book a Car
    </button>

    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobileNav">
    <a href="/">Home</a>
    <a href="/cars">Cars</a>
    <a href="/how-it-works">How It Works</a>
    <a href="/contact">Contact</a>
    <button class="button button-primary js-open-booking" data-car="General Booking" data-price="Choose your vehicle">Book a Car</button>
  </div>
</header>
